{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PolicySettings": {
    "RetryCount": 5,
    "RetrySeconds": 2
  },
  "GameRecordInfo": {
    "GameProviderCode": "WMTF",
    "GameProviderConfiguration": "WMTFConfiguration",
    "HangfirePrefix": "gamerecord-wmtf-hangfire:",
    "HangfireLocking": "gamerecord-wmtf-locking:",
    "IntervalMinutes": 15,
    "IntervalMinutesMax": 30,
    "IntervalMinutesMinimum": 1
  }
}
