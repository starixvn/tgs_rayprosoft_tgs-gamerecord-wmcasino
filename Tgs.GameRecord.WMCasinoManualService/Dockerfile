#See https://aka.ms/containerfastmode to understand how Visual Studio uses this Dockerfile to build your images for faster debugging.

FROM mcr.microsoft.com/dotnet/aspnet:6.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:6.0 AS build
ARG BuildConfiguration=Release
WORKDIR /src
COPY ["nuget.config", "."]
COPY ["Tgs.GameRecord.WMCasinoManualService/Tgs.GameRecord.WMCasinoManualService.csproj", "Tgs.GameRecord.WMCasinoManualService/"]
COPY ["Tgs.GameRecord.WMCasinoService.Core/Tgs.GameRecord.WMCasinoService.Core.csproj", "Tgs.GameRecord.WMCasinoService.Core/"]
RUN dotnet restore "Tgs.GameRecord.WMCasinoManualService/Tgs.GameRecord.WMCasinoManualService.csproj"
COPY . .
WORKDIR "/src/Tgs.GameRecord.WMCasinoManualService"
RUN dotnet build "Tgs.GameRecord.WMCasinoManualService.csproj" -c $BuildConfiguration -o /app/build

FROM build AS publish
ARG BuildConfiguration
RUN dotnet publish "Tgs.GameRecord.WMCasinoManualService.csproj" -c $BuildConfiguration -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Tgs.GameRecord.WMCasinoManualService.dll"]