{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameRecordInfo": {
    "GameProviderCode": "WMTF",
    "MinIntervalMinute": 5,
    "MaxIntervalMinute": 30,
    "IntervalMinute": 5,
    "LockMinute": 4,
    "MongoDefine": "gp.gamerecord.database",
    "MongoGlobPattern": "tgs.gp.gamerecord.database.round.wmtf"
  },
  "NatsSetting": {
    "Group": "gp.gamerecord.schedule",
    "Subject": "gp.gamerecord.schedule.wmtf"
  }
}
